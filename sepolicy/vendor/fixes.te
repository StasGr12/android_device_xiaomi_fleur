# Credit t.me/mars300809
# 1. Fast Charging 33W (Xiaomi batterysecret: sysfs + sysfs_typec + sysfs_batteryinfo)
allow batterysecret sysfs:file { read write open getattr };
allow batterysecret sysfs:dir { read open search getattr };
allow batterysecret sysfs:lnk_file { read getattr };
allow batterysecret sysfs_typec:file { read write open getattr };
allow batterysecret sysfs_typec:dir { read open search getattr };
allow batterysecret sysfs_typec:lnk_file { read getattr };
allow batterysecret sysfs_batteryinfo:file { read write open getattr };
allow batterysecret sysfs_batteryinfo:dir { read open search getattr };
allow batterysecret sysfs_batteryinfo:lnk_file { read getattr };

# 2. Vibrator (aw8622 / fleur)
allow hal_vibrator_default sysfs:file { read write open getattr };

# 3. Fingerprint (xiaomi)
allow hal_fingerprint_default sysfs:file { read write open getattr };

# 4. Health / Battery & Deep Sleep
allow hal_health_default sysfs:file { read write open getattr };

# 5. Power / CPU Idle & Performance HAL
allow hal_power_default sysfs:file { read write open getattr };

# 6. Display / HWC / SurfaceFlinger / GPU
allow hal_graphics_composer_default sysfs:file { read open getattr };
allow gpuservice fs_bpf:file { getattr };

# 7. Camera HAL, Camera App & Media

# 8. Telephony / Modem / Proximity Calibration (NVRAM)
allow nvram_daemon persist_data_file:file { read write open getattr append };

# 9. System Server & System Apps
allow system_app sysfs_zram:file { read open getattr };
